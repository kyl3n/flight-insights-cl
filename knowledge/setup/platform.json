    {
     "id": "firmware",
     "label": {
      "en": "Firmware",
      "uk": "Прошивка"
     },
     "type": "text",
     "required": false,
     "why": {
      "en": "Parameter dialect and known issues",
      "uk": "Діалект параметрів і відомі проблеми"
