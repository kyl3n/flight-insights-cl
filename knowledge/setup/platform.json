{
 "about": "The guided platform setup (spec: Platforms, airframes and build configuration, 'Setting up a new platform'). Every field says why it is asked; required fields say what a gap prevents, which the completeness check lists. 'detect' names a value the engine can read from a parameter file or a bench log.",
 "version": 1,
 "steps": [
  {
   "id": "platform",
   "title": {
    "en": "Platform",
    "uk": "Платформа"
   },
   "about": {
    "en": "What the aircraft is and how it flies. These answers decide which checks apply.",
    "uk": "Що це за апарат і як він літає. Від цих відповідей залежить, які перевірки застосовуються."
   },
   "fields": [
    {
     "id": "name",
     "label": {
      "en": "Name",
      "uk": "Назва"
     },
     "type": "text",
     "required": true,
     "why": {
      "en": "Shown everywhere the platform appears",
      "uk": "Показується скрізь, де є платформа"
     },
     "prevents": {
      "en": "Saving the platform",
      "uk": "Збереження платформи"
     }
    },
    {
     "id": "vehicle",
     "label": {
      "en": "Vehicle type",
      "uk": "Тип апарата"
     },
     "type": "choice",
     "required": true,
     "why": {
      "en": "Selects the analyzers and the parameter dialect",
      "uk": "Визначає аналізатори і діалект параметрів"
