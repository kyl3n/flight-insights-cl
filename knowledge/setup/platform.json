    },
    {
     "id": "motor_count",
     "label": {
      "en": "Motors",
      "uk": "Мотори"
     },
     "type": "integer",
     "required": true,
     "why": {
      "en": "Motor-out margin and per-motor checks",
      "uk": "Запас при відмові мотора і перевірки кожного мотора"
