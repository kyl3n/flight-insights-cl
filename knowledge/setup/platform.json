    {
     "id": "mounting",
     "label": {
      "en": "Mounting",
      "uk": "Кріплення"
     },
     "type": "choice",
     "required": true,
     "why": {
      "en": "Vibration expectations and isolation advice",
      "uk": "Очікувана вібрація і поради з віброізоляції"
