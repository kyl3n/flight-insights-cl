      "en": "Frame",
      "uk": "Рама"
     },
     "type": "text",
     "required": false,
     "why": {
      "en": "Motor count, coaxial pairs, yaw authority",
      "uk": "Кількість моторів, співвісні пари, керованість по курсу"
     },
     "detect": "frame_class"
    },
    {
     "id": "frame_type",
     "label": {
      "en": "Motor layout",
      "uk": "Розташування моторів"
     },
     "type": "text",
     "required": false,
     "why": {
      "en": "Which motor sits where",
      "uk": "Де стоїть кожен мотор"
     },
