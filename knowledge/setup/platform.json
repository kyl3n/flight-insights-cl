      "en": "Motor-out margin",
      "uk": "Запас при відмові мотора"
     },
     "detect": "motor_count"
    },
    {
     "id": "wheelbase_mm",
     "label": {
      "en": "Wheelbase",
      "uk": "Колісна база"
     },
     "type": "number",
     "required": false,
     "why": {
      "en": "Frame size, with the prop size",
      "uk": "Розмір рами разом із розміром пропелера"
     },
     "unit": "mm"
    },
    {
     "id": "payload",
     "label": {
      "en": "Payload",
      "uk": "Корисне навантаження"
     },
     "type": "choice",
     "required": true,
     "why": {
      "en": "A changing payload needs a tune that holds across weights",
      "uk": "Змінне навантаження потребує налаштування, що працює за різної ваги"
