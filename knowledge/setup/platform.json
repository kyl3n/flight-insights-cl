     "label": {
      "en": "Coldest flying temperature",
      "uk": "Найнижча температура польотів"
     },
     "type": "number",
     "required": false,
     "why": {
      "en": "Battery and motor limits in the cold",
      "uk": "Межі для батарей і моторів на морозі"
     },
     "unit": "°C"
    },
    {
     "id": "max_temp_c",
     "label": {
      "en": "Hottest flying temperature",
      "uk": "Найвища температура польотів"
     },
     "type": "number",
     "required": false,
     "why": {
      "en": "ESC and motor temperature margins",
      "uk": "Температурні запаси регуляторів і моторів"
     },
     "unit": "°C"
    },
    {
     "id": "flies_without_gnss",
     "label": {
      "en": "Must fly without GNSS",
      "uk": "Має літати без GNSS"
     },
     "type": "boolean",
     "required": false,
     "why": {
      "en": "Enables the readiness checks for flight without GNSS",
      "uk": "Вмикає перевірки готовності до польоту без GNSS"
     }
    }
   ]
  },
  {
   "id": "flight_controller",
   "title": {
    "en": "Flight controller",
    "uk": "Польотний контролер"
   },
   "about": {
    "en": "The board, its firmware and how it is mounted.",
