# Flight data: never commit real logs or parameter files.
# They contain exact positions and aircraft identifiers.
*.bin
*.BIN
*.tlog
*.tlog.raw
*.rlog
*.log
*.param
*.parm
*.params
# Mission files hold coordinates
*.waypoints
*.plan
# Scrubbed test fixtures (positions removed or shifted) are allowed only here
!tests/fixtures/**

# Secrets
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*recovery-key*

# Build output and dependencies
node_modules/
target/
dist/
build/
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.hypothesis/

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
